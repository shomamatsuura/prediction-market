# Copy to backend/.env for local development. Never commit backend/.env.
# With docker compose, DATABASE_URL is set by docker-compose.yml from POSTGRES_PASSWORD.
APP_ENV=development
# DATABASE_URL=postgresql+psycopg://markets:<password>@localhost:5432/markets

# Clerk (Dashboard -> API keys). These are not secrets, but must match your instance.
CLERK_JWKS_URL=https://<your-clerk-domain>/.well-known/jwks.json
CLERK_ISSUER=https://<your-clerk-domain>
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# Ingestion
SCHEDULER_ENABLED=true
INGESTION_INTERVAL_MINUTES=60
INGESTION_PAGE_SIZE=100
INGESTION_MAX_PAGES=5

# HTTP
CORS_ORIGINS=
# Per client IP. Requests made by the Next.js server all share its IP.
RATE_LIMIT=600/minute
DOCS_ENABLED=true
# Production behind a proxy: the proxy IPs uvicorn trusts for X-Forwarded-For.
# FORWARDED_ALLOW_IPS=*
