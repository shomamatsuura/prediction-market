# Copy to frontend/.env.local for local development. Never commit .env.local.

# Backend URL, used only by the Next.js server (never sent to the browser).
# With docker compose this is set to http://backend:8000 automatically.
API_URL=http://localhost:8000

# Clerk (Dashboard -> API keys). Leave both empty to run without sign-in.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# SECRET: never prefix with NEXT_PUBLIC_.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
